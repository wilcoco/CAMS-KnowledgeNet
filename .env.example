# 검증된 소셜 위키 (MVS) 환경변수 예시. 실제 값은 .env 또는 Railway 변수로.

# 데이터베이스. 미설정 시 로컬 SQLite 파일(./nightwish.db).
# Railway에서 Postgres 플러그인을 붙이면 DATABASE_URL이 자동 주입된다.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# 실제 LLM 북키핑(요약·엔티티·링크 추출)을 켜려면 Anthropic API 키.
# 없으면 결정론적 stub 북키퍼로 자동 폴백(서비스는 정상 동작).
# ANTHROPIC_API_KEY=sk-ant-...

# 북키핑에 쓸 모델 (기본 claude-opus-4-8). 비용을 줄이려면 claude-haiku-4-5 등.
# NIGHTWISH_LLM_MODEL=claude-opus-4-8

# 포트. Railway는 PORT를 자동 주입한다. 로컬 기본 8000.
# PORT=8000
